# Template .env untuk PRODUCTION (Hostinger shared). Salin ke server sebagai `.env`,
# isi semua nilai <...>, JANGAN commit file .env asli.
APP_NAME="Acegard"
# Waktu Indonesia Barat (WIB). Biarkan default.
APP_TIMEZONE=Asia/Jakarta
APP_ENV=production
APP_KEY=                # php artisan key:generate --show  (simpan salinannya di tempat aman!)
APP_DEBUG=false
APP_URL=https://<domain-anda>

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<db>
DB_USERNAME=<user-db-terbatas>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Hostinger shared: tidak ada worker permanen. Pakai cron `queue:work --stop-when-empty` (lihat docs/DEPLOY-HOSTINGER.md)
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Email sungguhan (wajib untuk undangan/reset password sales)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=<email>
MAIL_PASSWORD=<password-email>
MAIL_FROM_ADDRESS=<email>
MAIL_FROM_NAME="Acegard"

# Backup database (command backup:database)
BACKUP_KEEP_DAYS=14
# BACKUP_COPY_DISK=         # disk filesystem untuk salinan off-server
# MYSQLDUMP_PATH=/usr/bin/mysqldump

# Isi hanya jika ada reverse proxy/load balancer di depan aplikasi
# Isi bila ada reverse proxy/CDN di depan app (IP dipisah koma, atau * jika semua proxy tepercaya). Kosong = tanpa proxy.
# TRUSTED_PROXIES=
